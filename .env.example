# Massive.com (ex-Polygon.io) REST API key (REQUIRED). Auth is ?apiKey=...
MASSIVE_API_KEY=
# REST base URL (default https://api.polygon.io)
MASSIVE_API_BASE=https://api.polygon.io
# Delayed-options websocket host
WS_DELAYED_URL=wss://delayed.massive.com/options

# Flat-file S3 credentials from the Massive dashboard (S3 Access Keys page).
MASSIVE_S3_ACCESS_KEY_ID=REPLACE_ME_FROM_MASSIVE_DASHBOARD
MASSIVE_S3_SECRET_ACCESS_KEY=REPLACE_ME_FROM_MASSIVE_DASHBOARD
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles

# Local storage roots
DATA_ROOT=/data/massive
# LOG_ROOT defaults to {DATA_ROOT}/logs
# LOG_ROOT=/data/massive/logs

# Healthchecks.io monitoring. PREFER the ping key: it gives every job its own
# check (massive-<job>), auto-created on first ping. A single shared URL goes
# green as soon as any one job succeeds, hiding the failure that actually
# happens here -- a job that quietly stops running.
# Ping key: Healthchecks project -> Settings -> Ping Key.
# HEALTHCHECKS_PING_KEY=
# The PING ROOT (not the site root). Hosted is https://hc-ping.com; a
# self-hosted instance serves pings under /ping, so use https://<host>/ping.
# HEALTHCHECKS_BASE=https://hc-ping.com
