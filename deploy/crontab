# massive data_ingest_infra crontab — install with:  crontab deploy/crontab
#
# IMPORTANT: cron does NOT expand '~' or '$HOME' inside command strings, and
# does NOT expand variables in values. Before installing, replace the literal
# path /home/brad with your actual home directory, e.g.:
#     sed -i "s|/home/brad|$HOME|g" deploy/crontab
# (user 'brad' is the placeholder for the headless box user).
#
# Logs append to /data/massive/logs/cron.log (DATA_ROOT/logs). Structured
# per-run JSONL logs live under /data/massive/logs/<job>/dt=<date>/.
#
# flatfile_pull / reconcile default --date to the previous trading day, so the
# Tue-Sat 11:05 / 11:30 runs always target yesterday's session.
TZ=America/New_York
MAILTO=""
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

