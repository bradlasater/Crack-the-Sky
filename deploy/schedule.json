      "on_calendar": ["Tue-Sat 08:05:00"],
      "healthchecks": {"schedule": "5 8 * * 2-6", "grace_min": 90, "desc": "SPY minute bars, T-1 only"},
      "restart": {"sec": 120}
    },
    {
      "job": "grouped_daily",
      "unit": "massive-grouped-daily",
      "command": ["-m", "ingest.jobs.grouped_daily"],
      "cron": ["10 08 * * 2-6"],
      "on_calendar": ["Tue-Sat 08:10:00"],
      "healthchecks": {"schedule": "10 8 * * 2-6", "grace_min": 90, "desc": "Whole-market daily bars (SPY + VIX proxies)"},
      "restart": {"sec": 120}
    },
    {
      "job": "backfill_underlying",
      "unit": "massive-backfill-underlying",
      "command": ["scripts/backfill_underlying.py", "--max-sessions", "40", "--sleep", "6"],
      "cron": ["30 02 * * *"],
      "on_calendar": ["02:30:00"],
      "healthchecks": {"schedule": "30 2 * * *", "grace_min": 60, "desc": "Underlying history backfill (expiring window)"},
      "restart": {"sec": 120}
    },
    {
      "job": "rates_sync",
      "unit": "massive-rates-sync",
      "command": ["-m", "ingest.jobs.rates_sync"],
      "cron": ["20 08 * * 2-6"],
      "on_calendar": ["Tue-Sat 08:20:00"],
      "healthchecks": {"schedule": "20 8 * * 2-6", "grace_min": 90, "desc": "Treasury curve - the discount rate every IV inversion uses"},
      "restart": {"sec": 120}
    },
    {
      "job": "flatfile_pull",
      "unit": "massive-flatfile-pull",
      "command": ["-m", "ingest.jobs.flatfile_pull"],
      "cron": ["05 11 * * 2-6"],
      "on_calendar": ["Tue-Sat 11:05:00"],
      "healthchecks": {"schedule": "5 11 * * 2-6", "grace_min": 120, "desc": "T-1 S3 flat files - the authoritative record"},
      "restart": {"sec": 120}
    },
    {
      "job": "reconcile",
      "unit": "massive-reconcile",
      "command": ["-m", "ingest.jobs.reconcile"],
      "cron": ["30 11 * * 2-6"],
      "on_calendar": ["Tue-Sat 11:30:00"],
      "healthchecks": {"schedule": "30 11 * * 2-6", "grace_min": 120, "desc": "Rewrite minute bars from the flat file"},
      "restart": {"sec": 120}
    },
    {
      "job": "ibkr_executions",
      "unit": "massive-ibkr-executions",
      "command": ["-m", "ingest.jobs.ibkr_executions"],
      "cron": ["30 18 * * 1-5"],
      "on_calendar": ["Mon-Fri 18:30:00"],
      "healthchecks": {"schedule": "30 18 * * 1-5", "grace_min": 120, "desc": "Broker fills via IBKR Flex (no gateway)"},
      "restart": {"sec": 120}
    },
    {
      "job": "term_structure",
      "unit": "massive-term-structure",
      "command": ["-m", "pricing.term_structure"],
      "cron": ["00 12 * * 2-6"],
      "on_calendar": ["Tue-Sat 12:00:00"],
      "healthchecks": {"schedule": "0 12 * * 2-6", "grace_min": 120, "desc": "ATM vol term structure from T-1 day bars (derived, rebuildable)"},
      "restart": {"sec": 120}
    },
    {
      "job": "coverage_audit",
      "unit": "massive-coverage-audit",
      "command": ["-m", "ingest.jobs.coverage_audit"],
      "cron": ["30 12 * * 2-6"],
      "on_calendar": ["Tue-Sat 12:30:00"],
      "healthchecks": {"schedule": "30 12 * * 2-6", "grace_min": 180, "desc": "Did yesterday actually land? Fails loudly if not"},
      "restart": {"sec": 120}
    },
    {
      "job": "history_audit",
      "unit": "massive-history-audit",
      "command": ["-m", "ingest.jobs.history_audit"],
      "cron": ["00 13 * * 6"],
      "on_calendar": ["Sat 13:00:00"],
      "healthchecks": {"schedule": "0 13 * * 6", "grace_min": 300, "desc": "Is the whole archive still complete? Weekly, vendor-verified"},
      "restart": {"sec": 120}
    },
    {
      "job": "prune",
      "unit": "massive-prune",
      "command": ["bash", "scripts/prune_raw.sh", "--apply"],
      "cron": ["15 03 1 * *"],
      "on_calendar": ["*-*-01 03:15:00"],
      "healthchecks": null,
      "restart": {"sec": 300}
    }
  ],
  "extra_checks": {
    "ws_minute_bars_alive": {
      "schedule": "*/5 10-15 * * 1-5",
      "grace_min": 10,
      "desc": "Websocket capture liveness (5-min stats tick; covers 10:00-15:55)",
      "owner": "ws_minute_bars"
    }
  }
}
