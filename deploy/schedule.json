{
  "$comment": "The one canonical job schedule. Ansible reads this with include_vars and templates the systemd user timers from it (deploy/ansible/templates/), scripts/setup_healthchecks.py reads the healthchecks blocks, and the cron forms keep deploy/crontab honest while it stays installed during the cutover. Every entry carries the schedule twice -- cron and on_calendar -- and tests/test_schedule.py asserts the two fire at the same instants. Times are America/New_York wall clock (the box's system timezone; OnCalendar always fires in local time). Units whose job shares a name with another unit (the --expired / --eod passes) share that job's lock and Healthchecks check, so they carry no healthchecks block of their own. restart: null means the unit gets no Restart= line -- pointless when the next tick is seconds away. JSON, not YAML, so both Ansible and the Python stdlib read it with no new dependency.",
  "units": [
    {
      "job": "contracts_sync",
      "unit": "massive-contracts-sync",
      "command": ["-m", "ingest.jobs.contracts_sync"],
      "cron": ["00 08 * * 1-5", "30 16 * * 1-5"],
      "on_calendar": ["Mon-Fri 08:00:00", "Mon-Fri 16:30:00"],
      "healthchecks": {"schedule": "0 8 * * 1-5", "grace_min": 90, "desc": "SPY/SPX contract universe (also runs 16:30)"},
      "restart": {"sec": 120}
    },
    {
      "job": "dividends_sync",
      "unit": "massive-dividends-sync",
      "command": ["-m", "ingest.jobs.dividends_sync"],
      "cron": ["00 08 * * 1-5"],
      "on_calendar": ["Mon-Fri 08:00:00"],
      "healthchecks": {"schedule": "0 8 * * 1-5", "grace_min": 90, "desc": "SPY dividends and splits"},
      "restart": {"sec": 120}
    },
    {
      "job": "contracts_sync",
      "unit": "massive-contracts-sync-expired",
      "command": ["-m", "ingest.jobs.contracts_sync", "--expired"],
      "cron": ["00 09 * * 6"],
      "on_calendar": ["Sat 09:00:00"],
      "healthchecks": null,
      "restart": {"sec": 120}
    },
    {
      "job": "holidays_sync",
      "unit": "massive-holidays-sync",
      "command": ["-m", "ingest.jobs.holidays_sync"],
      "cron": ["00 07 * * 0"],
      "on_calendar": ["Sun 07:00:00"],
      "healthchecks": {"schedule": "0 7 * * 0", "grace_min": 240, "desc": "Market calendar refresh (weekly)"},
      "restart": {"sec": 120}
    },
    {
      "job": "snapshot_sweep",
      "unit": "massive-snapshot-sweep",
      "command": ["-m", "ingest.jobs.snapshot_sweep"],
      "cron": ["05 09 * * 1-5", "30-59 9 * * 1-5", "* 10-15 * * 1-5", "0-30 16 * * 1-5"],
      "on_calendar": ["Mon-Fri 09:05:00", "Mon-Fri 09:30..59:00", "Mon-Fri 10..15:00..59:00", "Mon-Fri 16:00..30:00"],
      "healthchecks": {"schedule": "* 10-15 * * 1-5", "grace_min": 10, "desc": "1/min full-chain snapshots - THE irreplaceable dataset"},
      "restart": null
    },
    {
      "job": "snapshot_sweep",
      "unit": "massive-snapshot-sweep-eod",
      "command": ["-m", "ingest.jobs.snapshot_sweep", "--eod"],
      "cron": ["35 16 * * 1-5"],
      "on_calendar": ["Mon-Fri 16:35:00"],
      "healthchecks": null,
      "restart": {"sec": 120}
    },
    {
      "job": "drift_check",
      "unit": "massive-drift-check",
      "command": ["-m", "pricing.drift_check"],
      "cron": ["00 17 * * 1-5"],
      "on_calendar": ["Mon-Fri 17:00:00"],
      "healthchecks": {"schedule": "0 17 * * 1-5", "grace_min": 60, "desc": "Own IV/Greeks identity canary (vendor diffs diagnostic). After EOD snapshot."},
      "restart": {"sec": 120}
    },
    {
      "job": "ws_minute_bars",
      "unit": "massive-ws-minute-bars",
      "command": ["-m", "ingest.jobs.ws_minute_bars"],
      "cron": ["25 09 * * 1-5"],
      "on_calendar": ["Mon-Fri 09:25:00"],
      "healthchecks": {"schedule": "25 9 * * 1-5", "grace_min": 480, "desc": "Delayed options websocket capture (long-running)"},
      "restart": {"sec": 10}
    },
    {
      "job": "trades_watchlist",
      "unit": "massive-trades-watchlist",
      "command": ["-m", "ingest.jobs.trades_watchlist"],
      "cron": ["30-55/5 9 * * 1-5", "*/5 10-15 * * 1-5", "0-30/5 16 * * 1-5"],
      "on_calendar": ["Mon-Fri 09:30..55/5:00", "Mon-Fri 10..15:00/5:00", "Mon-Fri 16:00..30/5:00"],
      "healthchecks": {"schedule": "*/5 10-15 * * 1-5", "grace_min": 20, "desc": "Same-day option trades for the liquid watchlist"},
      "restart": null
    },
    {
      "job": "underlying_bars",
      "unit": "massive-underlying-bars",
      "command": ["-m", "ingest.jobs.underlying_bars", "--prev-trading-day"],
