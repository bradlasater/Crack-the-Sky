# Massive.com (ex-Polygon.io) REST API key (REQUIRED). Auth is ?apiKey=...
MASSIVE_API_KEY=
# REST base URL (default https://api.polygon.io)
MASSIVE_API_BASE=https://api.polygon.io
# Delayed-options websocket host
WS_DELAYED_URL=wss://delayed.massive.com/options

# Flat-file S3 credentials from the Massive dashboard (S3 Access Keys page).
MASSIVE_S3_ACCESS_KEY_ID=REPLACE_ME_FROM_MASSIVE_DASHBOARD
MASSIVE_S3_SECRET_ACCESS_KEY=REPLACE_ME_FROM_MASSIVE_DASHBOARD
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles

# Local storage roots
DATA_ROOT=/data/massive
# LOG_ROOT defaults to {DATA_ROOT}/logs
# LOG_ROOT=/data/massive/logs

# Healthchecks.io monitoring. The ping key gives every job its own check
# (massive-<job>), auto-created on first ping. Without it, a job that dies
# dies silently. A single shared URL is not supported: it would go green as
# soon as any one job succeeds, hiding a job that quietly stops running.
# Legacy HEALTHCHECKS_PING_URL is rejected at startup; migrate to the ping key.
# Ping key: Healthchecks project -> Settings -> Ping Key.
# HEALTHCHECKS_PING_KEY=
# The PING ROOT (not the site root). Hosted is https://hc-ping.com; a
# self-hosted instance serves pings under /ping, so use https://<host>/ping.
# HEALTHCHECKS_BASE=https://hc-ping.com

# Daily identity canary (python -m pricing.drift_check). Own IV/Greeks from the
# as-of chain; pass/fail is put-call / reprice self-consistency. Vendor IV/greeks
# are diagnostic when present — null vendor IV is not a FAIL. No rates warehouse;
# this scalar is --r when the cron job is non-interactive.
DRIFT_CHECK_R=0.04
# Optional POST of the FAIL report JSON (Slack incoming webhook or similar).
# Do not block the job on this — Healthchecks + nonzero exit are the alert.
# DRIFT_ALERT_WEBHOOK=
