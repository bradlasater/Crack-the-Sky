# Systemd user service for the WS minute-bar capture -- the manual,
# always-supervised alternative to the scheduled start. The 09:25 start is now
# driven by a generated timer pair (deploy/schedule.json ->
# deploy/ansible/templates/massive-job.{service,timer}.j2), installed as the
# same unit name; do not install this file over the generated one.
# Install per-user:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/systemd/massive-ws-minute-bars.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now massive-ws-minute-bars
#   loginctl enable-linger $USER    # keep it running after logout
# The unit assumes the repo lives at ~/crack-the-sky (%h = home dir).
[Unit]
Description=Massive delayed options websocket minute-bar capture
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/crack-the-sky/.env
WorkingDirectory=%h/crack-the-sky
ExecStart=%h/crack-the-sky/venv/bin/python -m ingest.jobs.ws_minute_bars
# Restart on crashes, but NOT on the clean exit the job makes outside the
# 09:25-16:35 ET capture window. With a bare Restart=always this unit spun a
# no-op process every 10s all night; on-failure plus the exit-0 exemption
# keeps the supervisor honest while still recovering from a real fault.
Restart=on-failure
RestartPreventExitStatus=0
RestartSec=10
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
