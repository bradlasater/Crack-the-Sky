# Generated from deploy/schedule.json by deploy/ansible/playbook.yml.
# Do not edit on the box -- edit the schedule and re-run the playbook.
[Unit]
Description={{ item.unit }} schedule (America/New_York wall clock)

[Timer]
{% for cal in item.on_calendar -%}
OnCalendar={{ cal }}
{% endfor -%}
# AccuracySec=1s was the load-bearing line of the crontab cutover: at the
# default 1min, a timer could fire up to 60s after the cron run of the same
# job, long after that run had released /tmp/massive-<job>.lock, landing two
# snapshot files in one minute. The crontab is gone, but the pin stays -- the
# schedule is a wall-clock one (a sweep is stamped with the minute it claims to
# sample) and a minute of slack would let a fire drift into the next minute's
# slot, which coverage_audit reads as a gap plus a stray.
AccuracySec=1s
RandomizedDelaySec=0
# A missed snapshot sweep is worthless an hour later; Persistent=true would
# stampede the whole day's backlog after a reboot.
Persistent=false

[Install]
WantedBy=timers.target
