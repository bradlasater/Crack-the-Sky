# Generated by deploy/ansible/playbook.yml (no per-job expansion).
# Instantiated by OnFailure=massive-alert@<check-slug>.service on the massive-*
# job units. Ordinary non-zero exits already ping Healthchecks /fail from
# ingest.common.cli; this covers the deaths the job could not report itself --
# OOM kill, unit start failure, exhausted restart budget.
[Unit]
Description=Healthchecks /fail ping for %i (job unit failed before it could ping)

[Service]
Type=oneshot
EnvironmentFile=-%h/crack-the-sky/.env
# Best effort, same contract as cli.ping: no ping key -> no-op, curl failure ->
# swallowed, so the alert unit itself never enters the failed state. $$ is a
# literal $ in a unit file; %i is the check slug (massive-<job>).
ExecStart=/bin/bash -c 'if [ -n "$${HEALTHCHECKS_PING_KEY:-}" ]; then curl -fsS -m 10 -o /dev/null --data-binary "unit %i entered the failed state" "$${HEALTHCHECKS_BASE:-https://hc-ping.com}/$${HEALTHCHECKS_PING_KEY}/%i/fail?create=1" || true; fi'
